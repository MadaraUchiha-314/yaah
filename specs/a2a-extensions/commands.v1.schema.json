{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MadaraUchiha-314/yaah/extensions/commands/v1",
  "$defs": {
    "agentCardParams": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "scope": {
                "type": "string",
                "enum": [
                  "harness",
                  "surface"
                ]
              }
            },
            "required": [
              "name",
              "description",
              "scope"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "commands"
      ],
      "additionalProperties": false
    },
    "messageMetadata": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "command": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "executed",
            "failed",
            "unknown"
          ]
        }
      },
      "required": [
        "command",
        "status"
      ],
      "additionalProperties": false
    }
  }
}
