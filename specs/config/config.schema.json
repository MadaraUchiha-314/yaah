{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "composition": {
      "default": "cli",
      "type": "string"
    },
    "locale": {
      "default": "en",
      "type": "string"
    },
    "data_dir": {
      "default": "",
      "type": "string"
    },
    "model": {
      "default": {},
      "type": "object",
      "properties": {
        "llm": {
          "default": "openai/gpt-6.1-sol",
          "type": "string"
        },
        "effort": {
          "default": "medium",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "server": {
      "default": {},
      "type": "object",
      "properties": {
        "host": {
          "default": "127.0.0.1",
          "type": "string"
        },
        "port": {
          "default": 7420,
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "allowed_origins": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "trust_proxy": {
          "default": false,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "providers": {
      "default": {},
      "type": "object",
      "properties": {
        "openai": {
          "default": {},
          "type": "object",
          "properties": {
            "api_key_env": {
              "default": "OPENAI_API_KEY",
              "type": "string"
            },
            "base_url": {
              "type": "string"
            },
            "models": {
              "default": [
                "gpt-6.1-sol",
                "gpt-6.1-terra",
                "gpt-6-astra"
              ],
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "anthropic": {
          "default": {},
          "type": "object",
          "properties": {
            "api_key_env": {
              "default": "ANTHROPIC_API_KEY",
              "type": "string"
            },
            "models": {
              "default": [
                "claude-opus-5-5",
                "claude-sonnet-5-5",
                "claude-haiku-5-5",
                "claude-fable-5-2"
              ],
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "compatible": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "base_url": {
                "type": "string"
              },
              "api_key_env": {
                "type": "string"
              },
              "models": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "context_window": {
                "default": 128000,
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "max_output": {
                "default": 8192,
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "base_url"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "durable": {
      "default": {},
      "type": "object",
      "properties": {
        "mode": {
          "default": "none",
          "type": "string",
          "enum": [
            "none",
            "temporal-embedded",
            "temporal-remote"
          ]
        },
        "retry": {
          "default": {},
          "type": "object",
          "properties": {
            "initial_interval_ms": {
              "default": 1000,
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "backoff_coefficient": {
              "default": 2,
              "type": "number",
              "minimum": 1
            },
            "maximum_interval_ms": {
              "default": 60000,
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "maximum_attempts": {
              "default": 5,
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "temporal": {
          "default": {},
          "type": "object",
          "properties": {
            "address": {
              "default": "",
              "type": "string"
            },
            "namespace": {
              "default": "default",
              "type": "string"
            },
            "api_key_env": {
              "default": "TEMPORAL_API_KEY",
              "type": "string"
            },
            "task_queue": {
              "default": "yaah",
              "type": "string"
            },
            "port": {
              "default": 7233,
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "ui_port": {
              "default": 8233,
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "ui_url": {
              "type": "string"
            },
            "encryption_key_env": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "default": {},
      "type": "object",
      "properties": {
        "max_iterations": {
          "default": 50,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_agent_depth": {
          "default": 3,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_body_bytes": {
          "default": 10485760,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_parts": {
          "default": 32,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_part_bytes": {
          "default": 8388608,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_open_tasks_per_caller": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_requests_per_minute": {
          "default": 120,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_task_tokens": {
          "default": 2000000,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "compaction": {
      "default": {},
      "type": "object",
      "properties": {
        "threshold": {
          "default": 0.8,
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "keep_recent_fraction": {
          "default": 0.2,
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        }
      },
      "additionalProperties": false
    },
    "heartbeat": {
      "default": {},
      "type": "object",
      "properties": {
        "interval_ms": {
          "default": 30000,
          "type": "integer",
          "minimum": 100,
          "maximum": 9007199254740991
        },
        "stalled_after_ms": {
          "default": 300000,
          "type": "integer",
          "minimum": 100,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "o11y": {
      "default": {},
      "type": "object",
      "properties": {
        "log_level": {
          "default": "info",
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ]
        },
        "otlp_endpoint": {
          "type": "string"
        },
        "capture_content": {
          "default": false,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "a2a": {
      "default": {},
      "type": "object",
      "properties": {
        "allowed_hosts": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "mcp": {
      "default": {},
      "type": "object",
      "properties": {
        "servers": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "transport": {
                "type": "string",
                "enum": [
                  "stdio",
                  "http"
                ]
              },
              "command": {
                "type": "string"
              },
              "args": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "transport"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "agents": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "card_url": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "card_url"
        ],
        "additionalProperties": false
      }
    },
    "skills": {
      "default": {},
      "type": "object",
      "properties": {
        "paths": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "plugins": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      }
    },
    "overrides": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "config": {
            "$ref": "#/$defs/__schema0"
          },
          "disabled": {
            "type": "boolean"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
